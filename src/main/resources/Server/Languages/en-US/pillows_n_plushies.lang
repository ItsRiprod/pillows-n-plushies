# ==== pillowcode ====

items.Hexbook_Pillow.name = pillow hex book
items.Hexbook_Pillow.description = mrrrp... mrrrrrrrrrp~
pillowcode.Hexbook_Pillow.description = <color is="#b55088"><b>mrrrp... mrrrrrrrrrp~</b></color>\n\n<color is="#ffcc00"><b>6</b></color> <color is="#aaaaaa">Hex Slots</color> - <color is="#cc88ff"><b>+Void Damage</b></color> - <color is="#aaaaaa">+Spell Power</color>\n\n<b>To write spells</b>\nPlace into a <b>Pedestal</b> to draw Hexes into the Book\n\n<b>To cast spells</b>\nHold in your <b>Offhand</b> alongside a Hex Staff\nPress and Hold <b>Secondary</b> on the Staff to select from saved Hexes

items.Hexstaff_Pillow.name = pillow hex staff
items.Hexstaff_Pillow.description = <color is="#b55088"><b>mrow! nya!!</b></color>
pillowcode.Hexstaff_Pillow.description = <color is="#b55088"><b>mrow! nya!!</b></color>\n\n<color is="#ffcc00"><b>+200</b></color> <color is="#aaaaaa">Volatility</color> - <color is="#55ff55"><b>+1.6</b></color> <color is="#aaaaaa">Power</color> - <color is="#8888ff"><b>8</b></color> <color is="#aaaaaa">Charges</color> - <color is="#cc88ff"><b>Sphere</b></color> <color is="#aaaaaa">Style</color>\n\n<b>To draw spells</b>\nPress and Hold <b>Secondary</b> to enter <b>Drawing Mode</b>\nUse <b>Primary</b> to draw shapes in Drawing Mode\nRelease <b>Secondary</b> to submit Drawing\n\n<b>To cast spells</b>\nPress and Hold <b>Secondary</b> to view Drawn or Crafted Hexes\nHover over Hex to Select\nRelease <b>Secondary</b> to finalize Selection\n<b>Primary</b> to execute Hex\n\nPress <b>Ability 1</b> to Clear Active Spells\nPress <b>Ability 3</b> to Delete Hexes

